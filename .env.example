# 複製成 .env 後修改：cp .env.example .env
# .env 不會進 git，也不會被打包進 Docker 映像檔。

# 主控（管理台）帳號密碼。每次啟動都會套用到資料庫：
# 帳號不存在就建立，密碼和這裡不同就更新成這裡的值。
ADMIN_USER=admin
ADMIN_PASSWORD=請換成自己的密碼

# 每局比賽秒數與局間休息秒數（可省略，預設 600 / 60）
# 這兩個只是初始值：在管理台的「時間設定」改過之後就以資料庫為準，這裡不再覆蓋。
#ROUND_SECONDS=600
#BREAK_SECONDS=60

# 伺服器連接埠（可省略，預設 3000）
#PORT=3000
